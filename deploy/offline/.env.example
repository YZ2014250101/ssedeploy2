# =============================================================================
# SSEDeploy 交付配置（复制为 .env 后按需修改；docker compose 会自动读取）
# 修改端口后需重新执行 start 脚本（会重新创建容器）
# =============================================================================

# 版本标识：由打包脚本写入，升级时替换为新的离线包版本号
APP_VERSION=1.0.0

# 内嵌 K3s 镜像（离线包中已包含，无需修改）
K3S_IMAGE=rancher/k3s:v1.35.5-k3s1

# 对外端口（如被占用可修改，修改后重新启动）
FRONTEND_PORT=8000
BACKEND_PORT=8080
# K3s API 端口，仅用于本机 kubectl 调试
K3S_API_PORT=6443

# 业务命名空间
K8S_NAMESPACE=ssedeploy

# 管理员初始账号（首次启动创建，登录后请修改密码）
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# JWT 签名密钥：生产环境务必替换为随机长字符串
JWT_SECRET=ssedeploy-dev-secret-please-change

TZ=Asia/Shanghai

# 子域名主域：Pod 子域名映射生成 <前缀>.该域名 的 Ingress
BASE_DOMAIN=example.com
# IngressClass：k3s 内置 Traefik 为 traefik；禁用 Traefik 时需先部署网关
INGRESS_CLASS=traefik
